{
  "name": "crypto-p2p-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:contracts": "node scripts/run-forge.mjs test",
    "test:chain": "tsx tests/chain-e2e.ts",
    "test:browser": "tsx tests/browser-e2e.ts",
    "test:concurrency": "npm run build && tsx tests/concurrency-e2e.ts",
    "test:indexer-recovery": "npm run build && node scripts/run-forge.mjs build && tsx tests/indexer-recovery-e2e.ts",
    "chain:anvil": "node scripts/run-anvil.mjs",
    "chain:setup": "node scripts/run-forge.mjs build && tsx scripts/setup-local-chain.ts",
    "chain:mint": "tsx scripts/mint-local.ts",
    "test:api": "tsx tests/api-smoke.ts",
    "test:admin": "tsx tests/admin-api-smoke.ts",
    "data:prune": "tsx scripts/prune-sensitive-data.ts",
    "reservations:worker": "tsx scripts/expire-reservations-worker.ts",
    "chain:worker": "node --import tsx --conditions=react-server scripts/sync-chain-worker.ts",
    "workers:start": "node scripts/supervise-workers.mjs",
    "workers:status": "node scripts/workers-status.mjs",
    "workers:service:render": "node scripts/render-workers-service.mjs",
    "test:expiry-worker": "tsx tests/expiry-worker-e2e.ts",
    "test:postgres-schema": "node tests/postgres-schema-e2e.mjs",
    "test:postgres-api": "npm run build && tsx tests/postgres-api-e2e.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "solc": "0.8.30",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
